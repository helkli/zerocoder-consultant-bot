# =============================================
#  Подключение к ProxyAPI (запросы к ИИ-моделям)
# =============================================

# Ключ API из личного кабинета ProxyAPI (https://proxyapi.ru).
# Реальный ключ вы вставляете в файл .env вручную.
PROXY_API_KEY=

# Базовый адрес ProxyAPI для OpenAI-совместимых запросов.
# Обычно менять не нужно.
PROXY_API_BASE=https://api.proxyapi.ru/openai/v1

# Модель, которую использует бот (например: gpt-4o-mini, gpt-4o, gpt-5-mini).
OPENAI_MODEL=gpt-4o-mini

# Максимум токенов в ответе модели. Ограничивает стоимость одного запроса.
MAX_COMPLETION_TOKENS=300

# Сколько последних сообщений диалога бот помнит для каждого пользователя.
HISTORY_LIMIT=10

# =============================================
#  HTTPS (только если Python не доверяет
#  корневому сертификату вашего антивируса/прокси)
# =============================================

# Путь к PEM-файлу с корневым сертификатом, под которым работает HTTPS на
# вашей машине. Нужен, только если бот при запуске падает с ошибкой
# "CERTIFICATE_VERIFY_FAILED". Как получить файл — см. README.
SSL_CA_BUNDLE=

# =============================================
#  Подключение к сообществу ВКонтакте
# =============================================

# Ключ доступа сообщества ВКонтакте (с правами на сообщения).
# Вставляется вручную: Управление сообществом -> Работа с API.
VK_TOKEN=

# Числовой ID сообщества (например: 12345678). Указан в разделе
# «Работа с API» в управлении сообществом.
VK_GROUP_ID=

# Версия VK API. Менять не нужно.
VK_API_VERSION=5.199